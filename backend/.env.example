# Copy to .env and adjust.

# Postgres (docker-compose at repo root starts one on 5432)
DATABASE_URL=postgresql+asyncpg://antarik:antarik@localhost:5432/antarik

# Change this in every real deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Upstream inference server — any OpenAI-compatible endpoint.
# Local dev: Ollama (http://localhost:11434/v1). Production: vLLM / SGLang / TGI.
UPSTREAM_BASE_URL=http://localhost:11434/v1
UPSTREAM_API_KEY=not-needed-for-ollama

# Public model name -> model served by the upstream. JSON object.
MODEL_MAP={"antarik-fast":"llama3.2:3b","antarik-reason":"qwen2.5:14b","antarik-code":"qwen2.5-coder:7b"}

# Allowed browser origins for the React app
CORS_ORIGINS=["http://localhost:5173"]
